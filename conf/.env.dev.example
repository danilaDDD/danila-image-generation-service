ENV=dev
DEBUG=true

# Хосты и порты — как их видно ИЗНУТРИ сети docker-compose (имена сервисов).
# Файл рассчитан на `docker compose up`; для запуска с хост-машины
# раскомментируйте блок «локальный запуск» ниже и закомментируйте docker-значения.
MONGO_HOST=app_db
MONGO_PORT=27017
MONGO_DB_NAME=imageGenerationDB
# Контейнер mongo:7 поднимается без аутентификации (conf/.env.db пустой) — креды не задаём.
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_URL=redis://redis:6379/1

# --- Локальный запуск (uvicorn/celery с хост-машины, контейнеры инфраструктуры подняты) ---
# Порты — опубликованные наружу в docker-compose.yml.
# MONGO_HOST=localhost
# MONGO_PORT=27018
# CELERY_BROKER_URL=redis://localhost:6380/0
# CELERY_RESULT_URL=redis://localhost:6380/1
