ENV=test
DEBUG=false

# Хосты и порты — как их видно ИЗНУТРИ сети docker-compose (профиль test).
# Файл рассчитан на `docker compose --profile test run --rm test_app`; для локального
# `pytest -q` раскомментируйте блок «локальный запуск» ниже.
MONGO_HOST=test_db
MONGO_PORT=27017
MONGO_DB_NAME=imageGenerationTestDB
# test_db поднимается без аутентификации — креды не задаём.
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Отдельные базы Redis (2 и 3), чтобы тесты не пересекались с dev-очередями.
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_URL=redis://redis:6379/3

# --- Локальный запуск (pytest с хост-машины по опубликованным портам) ---
# MONGO_HOST=localhost
# MONGO_PORT=27019
# CELERY_BROKER_URL=redis://localhost:6380/2
# CELERY_RESULT_URL=redis://localhost:6380/3
